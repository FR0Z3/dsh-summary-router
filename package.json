{
  "name": "dsh-summary-router",
  "version": "0.2.1",
  "description": "Choose which provider and model write DeepSeek Harness compaction summaries, per session and per workspace, with fallback chains.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "summarization",
    "routing"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./logic": "./logic.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "logic.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check index.js && node --check logic.js && node --check client.js && node scripts/check-locale.mjs && node --test \"tests/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4 || >=3.18.5-alpha.1 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
